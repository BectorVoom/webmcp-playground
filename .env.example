# OpenAI-compatible endpoint for the local model.
# Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
# llama.cpp server: http://localhost:8080/v1   vLLM: http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1

# Sent as `Authorization: Bearer` when non-empty. Ollama ignores it; LM Studio
# and vLLM sometimes require any non-empty value.
LLM_API_KEY=

# Leave empty to fall back to the first model the endpoint reports.
LLM_DEFAULT_MODEL=

LLM_TIMEOUT_MS=120000

# Server interface. Keep loopback for local work. A production container or VM normally binds all
# interfaces and terminates HTTPS at its reverse proxy/load balancer.
HOST=127.0.0.1
PORT=8787

# Chrome exposes WebMCP to public sites through an Origin Trial (desktop M149-M156). Register the
# exact production HTTPS origin at https://developer.chrome.com/origintrials/ and put the resulting
# public token here. The server sends it as `Origin-Trial`; leave empty for local flag-based testing
# or browsers without WebMCP, where the application deliberately uses its in-memory host.
WEBMCP_ORIGIN_TRIAL_TOKEN=

TRACE_DIR=.traces
TRACE_WRITE_ENABLED=true

# Where the fitted ERA5 rainfall climatology is kept between runs. One archive
# call asks for 66 years of daily values, and the free tier's daily allowance is
# small enough that a few dozen of them exhaust it — so a location is fetched
# once and read from here forever after. Set empty to disable and re-ask every
# restart, which is only sensible if you have a paid key.
CLIMATE_CACHE_DIR=.cache/era5

# Where mapped OpenStreetMap embankments are kept between runs. Overpass is a
# free community service: it answers a 20 km box with megabytes of geometry,
# rate-limits under load, and asks not to be hammered. An outage is not an error
# here — the model degrades to "no known defences" — so without this store a
# restart can quietly cost you the levees. Set empty to disable.
LEVEE_CACHE_DIR=.cache/osm-levees

# Where decoded DEM tiles are kept between runs. Elevation tiles are static in a
# way almost nothing else here is — the ground does not move between requests —
# so a tile is worth fetching once per machine, and a 20 km circle is 16 to 49 of
# them. Empty (the default) disables it: unlike the two stores above, this one is
# keyed by tile coordinate alone, so it answers whoever asks for that ground —
# including a test that stubbed its upstream with a synthetic hillside. Turn it
# on deliberately.
DEM_CACHE_DIR=

# Where mapped lakes, reservoirs and river channels are kept between runs. The
# model cannot tell standing water from low ground, so without this it reports
# every lake in the window as flood. Dams, storm drainage and building geometry
# share the same reuse contract and are kept under the `infrastructure/`
# subdirectory. Same upstream and same bargain as the embankments above. Set
# empty to disable the disk store (not the feature).
WATER_CACHE_DIR=.cache/osm-water

# --- European flood forecast (Copernicus CEMS) ---------------------------------
#
# Personal access token for a Copernicus/ECMWF account, from
# https://ewds.climate.copernicus.eu/profile. The same token works on both stores.
#
# You can leave this empty if you already keep the token in Copernicus's own
# `.cdsapirc` format — two colon-headed lines, in this file or in ~/.cdsapirc:
#
#     url: https://cds.climate.copernicus.eu/api
#     key: 01234567-89ab-cdef-0123-456789abcdef
#
# A .env loader reads `NAME=value` lines and skips that block silently, so it is
# parsed deliberately; see server/cems/credentials.ts. Only the `key:` is used.
CEMS_API_KEY=

# Which store to retrieve from. The default is the ECMWF Data Store, and it is
# almost certainly what you want: CEMS-Flood moved there, and the GloFAS forecast
# is not in the Climate Data Store's catalogue at all — pointing this at
# cds.climate.copernicus.eu fails as a 404 on the dataset.
CEMS_API_URL=https://ewds.climate.copernicus.eu/api

# Before anything can be retrieved, the account must accept two licences once, in
# a browser. Until then every call is refused with 403 "user didn't accept all
# required site policies":
#   https://ewds.climate.copernicus.eu/licences/terms-of-use-cems
#   https://ewds.climate.copernicus.eu/datasets/cems-glofas-forecast (Manage licences)
#
# Where Copernicus retrievals are kept between runs. This store is not optional
# in the way the others are. Copernicus answers a request as a *queued job*, not
# a reply, and it accepts only one calendar year per historical request with one
# request queued at a time — so the thirty years of river-discharge history that
# a location's flood thresholds are fitted from is 30 jobs run back to back, a
# few hours in all. It is asked for once per place, ever, and read from here
# forever after. Empty disables the store, and disables the European forecast
# with it: there would be nowhere to put an answer that arrives after the
# request has gone.
#
# Warm a site ahead of time, and go and do something else:
#   bun tools/warm-cems.ts <lat> <lon>
CEMS_CACHE_DIR=.cache/cems

# Disaster Safety Tool Set Configuration (Design §10.1)
# `fixture` serves recorded data and needs no network. Flood zones are recorded for Fukui and Tokyo
# only; anywhere else answers "no coverage here" rather than drawing an empty map. Set `live` to
# query the real GSI hazard raster, which covers all of Japan and needs no key.
GEO_DATA_MODE=fixture
# `ewds.climate.copernicus.eu` is the ECMWF Data Store, and `os-api.cci2.ecmwf.int` is the object
# store a finished retrieval is collected from — a download that cannot reach it is a job that
# queued, ran, and was thrown away.
GEO_ALLOWED_HOSTS=api.weather.gov,hazards.fema.gov,gis.fema.gov,cyberjapandata.gsi.go.jp,disaportaldata.gsi.go.jp,www.jma.go.jp,emergency.copernicus.eu,overpass-api.de,lambert.openstreetmap.de,overpass.private.coffee,feeds.meteoalarm.org,api.stadiamaps.com,api-eu.stadiamaps.com,valhalla1.openstreetmap.de,nominatim.openstreetmap.org,ows.globalfloods.eu,s3.amazonaws.com,api.open-meteo.com,archive-api.open-meteo.com,ewds.climate.copernicus.eu,cds.climate.copernicus.eu,os-api.cci2.ecmwf.int

# Routing runs on Stadia Maps, which hosts Valhalla on OSM data. Live routing needs a key from
# https://client.stadiamaps.com/ — without one the engine answers 401 and the app falls back to
# recorded routes, saying so. Use api-eu.stadiamaps.com to keep requests in the EU.
# For a bare Valhalla instead, set ROUTING_ROUTE_PATH=/route and leave ROUTING_API_KEY empty.
ROUTING_BASE_URL=https://api.stadiamaps.com
ROUTING_ROUTE_PATH=/route/v1
ROUTING_API_KEY=

# Routing has its own mode, separate from GEO_DATA_MODE. The recorded replies only cover the one
# origin they were captured at, so tying routing to the global mode left the map drawing no routes
# anywhere else. `auto` routes live wherever there is an engine to route with (a key here, or a
# host that needs none) and falls back to the recordings otherwise; `fixture` forces the
# recordings, for a demo that must not touch the network; `live` forces the engine.
ROUTING_MODE=auto
MAP_TILE_URL=
MAP_TILE_KEY=
GEO_CACHE_TTL_ALERTS_MS=60000
GEO_CACHE_TTL_FLOOD_MS=600000
GEO_CACHE_TTL_PLACES_MS=86400000

# Place-name lookups (disaster.geocode) go to OpenStreetMap's Nominatim, which needs no key but asks
# for about one request a second and no bulk use. A day is the right TTL: a station moves on the
# timescale of a construction project, and the cache is how that policy is actually honoured.
GEO_CACHE_TTL_GEOCODE_MS=86400000
GEO_CACHE_TTL_TILES_MS=86400000
# Tiles one flood query may fetch. A 20 km radius needs 441 at zoom 14; below that the outer part
# of the circle is not examined and the result says so. Lower it to trade coverage for speed.
GEO_TILE_CAP=512
GEO_TIMEOUT_MS=8000
GEO_BREAKER_THRESHOLD=5
GEO_BREAKER_COOLDOWN_MS=60000
GEO_COORD_PRECISION=4
GEO_TRACE_COORD_PRECISION=3
